# Reflexología Holística — variables de entorno

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp internacional sin + ni espacios. El fallback local aprobado por el
# prompt es 5491169702403; confirmar el número antes de publicar.
NEXT_PUBLIC_WHATSAPP_NUMBER=5491169702403

# Completar únicamente cuando la ubicación pública esté confirmada.
NEXT_PUBLIC_LOCATION_LABEL=

# Mantener draft hasta tener autorización de assets, datos comerciales,
# validación visual del propietario y aprobación de publicación.
PUBLICATION_STATUS=draft
